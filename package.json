{
  "name": "agentic-flow-kit",
  "version": "2.1.0",
  "description": "AI-Native workflow engine installer: generate .agents, git hooks, host adapters, wiki/workflow scaffolds from zero.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "flow-kit": "bin/flow-kit.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "ai-native",
    "workflow",
    "agents",
    "codex",
    "claude-code",
    "trae",
    "codebuddy",
    "installer"
  ],
  "files": [
    "bin",
    "src",
    "templates",
    "locales",
    "schemas",
    "README.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check:i18n": "node tools/make-en-host-overrides.mjs --check",
    "policy:check": "node tools/policy-check.mjs",
    "extract": "node tools/extract-from-project.mjs",
    "doctor:self": "node bin/flow-kit.mjs doctor --target .",
    "prepublishOnly": "node --test tests/*.test.mjs"
  }
}
