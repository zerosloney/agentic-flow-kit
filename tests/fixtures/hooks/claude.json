[
  {
    "event": "PreToolUse",
    "matcher": "Write|Edit|MultiEdit",
    "hooks": [
      {
        "type": "command",
        "command": "flow-kit hook pre-write-check",
        "timeout": 120
      }
    ]
  },
  {
    "event": "PreToolUse",
    "matcher": "Bash",
    "hooks": [
      {
        "type": "command",
        "command": "flow-kit hook pre-shell-check",
        "timeout": 800
      }
    ]
  }
]
