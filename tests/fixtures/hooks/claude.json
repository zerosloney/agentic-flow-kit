[
  {
    "event": "PreToolUse",
    "matcher": "Write|Edit|MultiEdit",
    "hooks": [
      {
        "type": "command",
        "command": "flow-kit hook pre-write-check",
        "timeout": 120
      }
    ]
  },
  {
    "event": "PreToolUse",
    "matcher": "Bash",
    "hooks": [
      {
        "type": "command",
        "command": "flow-kit hook pre-shell-check",
        "timeout": 800
      }
    ]
  },
  {
    "event": "PostToolUse",
    "matcher": "Agent",
    "hooks": [
      {
        "type": "command",
        "command": "flow-kit hook usage-collect",
        "timeout": 10
      }
    ]
  },
  {
    "event": "SessionStart",
    "matcher": "startup|resume|clear|compact|fork",
    "hooks": [
      {
        "type": "command",
        "command": "flow-kit hook session-context",
        "timeout": 10
      }
    ]
  }
]
