[
  {
    "event": "PreToolUse",
    "matcher": "WRITE|EDIT",
    "hooks": [
      {
        "type": "command",
        "command": "flow-kit hook pre-write-check",
        "timeout": 120
      }
    ]
  },
  {
    "event": "PreToolUse",
    "matcher": "SHELL",
    "hooks": [
      {
        "type": "command",
        "command": "flow-kit hook pre-shell-check",
        "timeout": 600
      }
    ]
  }
]
