[
  {
    "event": "PreToolUse",
    "matcher": "write_file|edit|replace|multiedit",
    "hooks": [
      {
        "type": "command",
        "command": "flow-kit hook pre-write-check",
        "timeout": 120
      }
    ]
  },
  {
    "event": "PreToolUse",
    "matcher": "run_shell_command|shell",
    "hooks": [
      {
        "type": "command",
        "command": "flow-kit hook pre-shell-check",
        "timeout": 800
      }
    ]
  }
]
