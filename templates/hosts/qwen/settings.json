{
  "permissions": {
    "allow": [
{{stackAllowBashSpace}}      "Bash(npm run *)",
      "Bash(npm install *)",
      "Bash(npm ci *)",
      "Bash(node *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git log *)",
      "Bash(git push *)",
      "Bash(chrome *)",
      "Bash(dir *)"
    ],
    "deny": [
      "Bash(dotnet ef *)",
      "Bash(git reset --hard *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(drop database *)",
      "Bash(* --no-verify*)"
    ],
    "ask": [
      "Bash(git checkout *)",
      "Bash(git clean *)",
      "Bash(git branch -D *)",
      "Bash(rm -rf *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "write_file|edit|replace|multiedit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$QWEN_PROJECT_DIR\"/.agents/hooks/pre-write-check.cjs",
            "timeout": 120
          }
        ]
      },
      {
        "matcher": "run_shell_command|shell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$QWEN_PROJECT_DIR\"/.agents/hooks/pre-shell-check.cjs",
            "timeout": 800
          }
        ]
      }
    ]
  },
  "$version": 4
}
