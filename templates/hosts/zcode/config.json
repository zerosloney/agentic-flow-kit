{
  "hooks": {
    "enabled": true,
    "events": {
      "PreToolUse": [
        {
          "matcher": "Edit|Write|MultiEdit",
          "hooks": [
            {
              "type": "command",
              "command": "flow-kit hook pre-write-check",
              "enabled": true,
              "timeout": 60
            }
          ]
        },
        {
          "matcher": "Bash|RunCommand|Shell|Terminal|PowerShell",
          "hooks": [
            {
              "type": "command",
              "command": "flow-kit hook pre-shell-check",
              "enabled": true,
              "timeout": 600
            }
          ]
        }
      ]
    }
  }
}
