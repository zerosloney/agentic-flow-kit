{
  "_note": "栈层规则包（cpp）：kit 管理的默认规则层。层级顺序：legacy ← stack.<栈名>.json ← project ← local。项目要改规则请写 project.json（同 id 整条覆盖）。",
  "version": 1,
  "rules": [
    {
      "id": "product.ctest",
      "name": "C++ 测试",
      "phase": "verify",
      "face": "tests",
      "severity": "block",
      "when": ["CMakeLists.txt"],
      "assert": { "kind": "command", "args": { "run": "ctest --output-on-failure" } },
      "message": { "zh": "ctest 测试未通过", "en": "ctest failed" }
    },
    {
      "id": "product.cpp-build",
      "name": "C++ 编译构建",
      "phase": "verify",
      "face": "code",
      "severity": "block",
      "when": ["CMakeLists.txt"],
      "assert": { "kind": "command", "args": { "run": "cmake --build build" } },
      "message": { "zh": "cmake 编译构建未通过", "en": "cmake build failed" }
    }
  ],
  "waivers": []
}
