{
  "_note": "栈层规则包（java）：kit 管理的默认规则层。层级顺序：legacy ← stack.<栈名>.json ← project ← local。项目要改规则请写 project.json（同 id 整条覆盖）。",
  "version": 1,
  "rules": [
    {
      "id": "product.java-test",
      "name": "Java 测试",
      "phase": "verify",
      "face": "tests",
      "severity": "block",
      "when": ["pom.xml"],
      "assert": { "kind": "command", "args": { "run": "mvn test" } },
      "message": { "zh": "mvn test 测试未通过", "en": "mvn test failed" }
    }
  ],
  "waivers": []
}
