{
  "_note": "项目产品门配置（verify 基础表之外的本项目技术栈门）：id/name/cmd 必填，folder 默认 '.'，when 任一满足才启用（路径存在 / 尾部 * 一层通配 / pkg:<package.json 点分路径>）。verify 会把这里的门追加到 wiki-consistency 之后；按项目实际调整，用不到的条目直接删除。",
  "gates": [
    { "id": "type-check", "name": "TypeScript 类型检查", "cmd": "npm run type-check", "folder": ".", "when": ["pkg:scripts.type-check"] },
    { "id": "node-lint", "name": "代码规范检查", "cmd": "npm run lint", "folder": ".", "when": ["pkg:scripts.lint"] },
    { "id": "node-test", "name": "单元测试", "cmd": "npm test", "folder": ".", "when": ["pkg:scripts.test"] },
    { "id": "node-build", "name": "项目构建", "cmd": "npm run build", "folder": ".", "when": ["pkg:scripts.build"] }
  ]
}
