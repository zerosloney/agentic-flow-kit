{
  "_note": "栈层规则包（go）：kit 管理的默认规则层。层级顺序：legacy ← stack.<栈名>.json ← project ← local。项目要改规则请写 project.json（同 id 整条覆盖）。",
  "version": 1,
  "rules": [
    {
      "id": "product.go-test",
      "name": "Go 单元测试",
      "phase": "verify",
      "face": "tests",
      "severity": "block",
      "when": ["go.mod"],
      "assert": { "kind": "command", "args": { "run": "go test ./..." } },
      "message": { "zh": "go test 单元测试未通过", "en": "go test failed" }
    },
    {
      "id": "product.go-vet",
      "name": "Go 静态检查",
      "phase": "verify",
      "face": "code",
      "severity": "block",
      "when": ["go.mod"],
      "assert": { "kind": "command", "args": { "run": "go vet ./..." } },
      "message": { "zh": "go vet 检查未通过", "en": "go vet failed" }
    },
    {
      "id": "product.go-build",
      "name": "Go 编译构建",
      "phase": "verify",
      "face": "code",
      "severity": "block",
      "when": ["go.mod"],
      "assert": { "kind": "command", "args": { "run": "go build ./..." } },
      "message": { "zh": "go build 构建未通过", "en": "go build failed" }
    }
  ],
  "waivers": []
}
