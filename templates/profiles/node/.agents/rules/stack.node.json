{
  "_note": "栈层规则包（node）：kit 管理的默认规则层。层级顺序：legacy ← stack.<栈名>.json ← project ← local。项目要改规则请写 project.json（同 id 整条覆盖）。",
  "version": 1,
  "rules": [
    {
      "id": "product.node-lint",
      "name": "代码规范检查",
      "phase": "verify",
      "face": "code",
      "severity": "block",
      "when": ["pkg:scripts.lint"],
      "assert": { "kind": "command", "args": { "run": "npm run lint" } },
      "message": { "zh": "npm run lint 检查未通过", "en": "npm run lint failed" }
    },
    {
      "id": "product.node-test",
      "name": "单元测试",
      "phase": "verify",
      "face": "tests",
      "severity": "block",
      "when": ["pkg:scripts.test"],
      "assert": { "kind": "command", "args": { "run": "npm test" } },
      "message": { "zh": "npm test 单元测试未通过", "en": "npm test failed" }
    },
    {
      "id": "product.node-build",
      "name": "项目构建",
      "phase": "verify",
      "face": "code",
      "severity": "block",
      "when": ["pkg:scripts.build"],
      "assert": { "kind": "command", "args": { "run": "npm run build" } },
      "message": { "zh": "npm run build 构建未通过", "en": "npm run build failed" }
    }
  ],
  "waivers": []
}
