# 引擎运行态（各机各自产生，不共享）
tmp/
.agents/cache/
.agents/tmp/
.agents/tools/
.agents/verifications.jsonl
.agents/judgments.jsonl
.agents/endorsements.d/
.agents/endorsements.jsonl
.agents/usage.jsonl
.agents/arena/
.agents/traces/
.agents/prescriptions.jsonl
.agents/notes/runtime-env.local.md
.agents/notes/prescriptions.json
.agents/config/model-roles.local.json
.agents/rules/local.json
.agents/rules/local.yml
.agents/rules/local.yaml
# 信任模式及其审计台账（本机运行态，不入库；trust-mode --verify 以台账对质当前配置）
.agents/trust-mode.json
.agents/trust-mode-audit.jsonl
# 公证签名密钥（默认含私钥，不入库；--out 可改落盘位置）
.agents/keys/
# 升级用基线（含上次安装内容，默认不入库；--no-baseline 可关闭）
.agents/.kit/

# 本机宿主目录（默认不入库；--track-hosts 可关闭）
{{hostIgnores}}
