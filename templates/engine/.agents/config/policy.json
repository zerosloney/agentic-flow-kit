{
  "$schema": "policy/config@1",
  "version": 1,
  "registry": ".agents/config/mechanism-registry.md",
  "surfaces": {
    "gateBudgets": ".agents/config/gate-budgets.json",
    "ruleBudgets": ".agents/config/rule-budgets.txt",
    "workflowEnums": ".agents/config/workflow-enums.txt",
    "pipeline": ".agents/config/pipeline.json",
    "steering": ".agents/config/steering.json",
    "agentEval": ".agents/config/agent-eval.json",
    "modelRoles": ".agents/config/model-roles.json",
    "prReview": ".agents/config/pr-review.json"
  },
  "optionalSurfaces": [
    "ruleBudgets"
  ],
  "mechanisms": {
