{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-flow-kit/project-profile.schema.json",
  "title": "agentic-flow-kit project profile",
  "type": "object",
  "required": ["stack"],
  "properties": {
    "stack": { "enum": ["dotnet", "node", "typescript", "rust", "go", "java", "empty"] },
    "surfaces": {
      "type": "array",
      "description": "组合式 profile 切面闭集：叠加在 stack 之上，按声明顺序合并；同名文件后声明者覆盖。",
      "items": { "enum": ["frontend", "api", "data"] },
      "uniqueItems": true
    },
    "ports": {
      "type": "object",
      "properties": {
        "api": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "web": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "board": { "type": "integer", "minimum": 1, "maximum": 65535 }
      },
      "additionalProperties": false
    },
    "paths": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "commands": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  },
  "additionalProperties": true
}
