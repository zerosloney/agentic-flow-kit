{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-flow-kit/install-manifest.schema.json",
  "title": "agentic-flow-kit install manifest",
  "type": "object",
  "required": ["kit", "version", "language", "hosts", "stack", "files"],
  "properties": {
    "kit": { "const": "agentic-flow-kit" },
    "version": { "type": "string" },
    "installedAt": { "type": "string", "format": "date-time" },
    "language": { "enum": ["zh-CN", "en"] },
    "hosts": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
      "description": "内置宿主或通过 --host-manifest / .flow-kit/hosts 加载的外部宿主。",
      "uniqueItems": true
    },
    "stack": { "enum": ["dotnet", "node", "typescript", "rust", "go", "java", "empty"] },
    "surfaces": {
      "type": "array",
      "description": "组合式 profile 切面（frontend / api / data），按声明顺序。",
      "items": { "enum": ["frontend", "api", "data"] },
      "uniqueItems": true
    },
    "tier": { "enum": ["lean", "standard", "enterprise"] },
    "hardened": { "type": "boolean" },
    "mcp": {
      "type": "boolean",
      "description": "是否编译 MCP 配置；false 表示安装时使用了 --no-mcp。"
    },
    "devcontainer": {
      "type": "boolean",
      "description": "是否生成开发容器声明（R3-8 沙箱面）；false 表示安装时使用了 --no-devcontainer。"
    },
    "baseline": {
      "type": "boolean",
      "description": "是否留存升级用基线；false 表示安装时使用了 --no-baseline。"
    },
    "baselineVersion": {
      "type": ["string", "null"],
      "description": "写入基线时的安装器版本；基线内容不参与 manifest 哈希。"
    },
    "enterprise": {
      "type": "object",
      "description": "enterprise / --hardened 实际启用的加固矩阵与证明链状态。",
      "additionalProperties": false,
      "required": ["posture", "hosts", "gaps", "proofChain", "policyChecks"],
      "properties": {
        "posture": { "enum": ["hardened"] },
        "hosts": {
          "type": "object",
          "additionalProperties": { "enum": ["managed", "permissions", "hooks", "none"] }
        },
        "gaps": { "type": "array", "items": { "type": "string" } },
        "proofChain": { "type": "boolean" },
        "policyChecks": {
          "type": "array",
          "items": { "enum": ["githooks", "ci", "permissions"] }
        }
      }
    },
    "mcpServers": {
      "type": "object",
      "description": "目标 MCP 配置文件 -> 本工具写入的 server 名列表（卸载时只摘除这些条目）。",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string" },
        "uniqueItems": true
      }
    },
    "managedPermissions": {
      "type": "object",
      "description": "宿主配置 -> 上次由本工具写入的 allow/deny/ask 条目；卸载/升级只替换这些条目，保留用户自建权限。",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "allow": { "type": "array", "items": { "type": "string" } },
          "deny": { "type": "array", "items": { "type": "string" } },
          "ask": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "mergeOrigins": {
      "type": "object",
      "description": "合并型配置首次安装时是否已存在；created 且未被改动时卸载可整文件删除。",
      "additionalProperties": { "enum": ["created", "existing"] }
    },
    "projectName": { "type": "string" },
    "trackHosts": { "type": "boolean" },
    "derived": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "skills": {
      "type": "object",
      "description": "category: skill——add-skill 安装的外部技能（来源 / 版本 / 校验和 / 逐文件哈希）；与 .agents/skills.lock.json 同步。",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "version", "checksum", "installedAt", "files"],
        "properties": {
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "spec", "resolved"],
            "properties": {
              "type": { "enum": ["local", "git", "npm"] },
              "spec": { "type": "string" },
              "resolved": { "type": "string" }
            }
          },
          "version": { "type": "string" },
          "checksum": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "installedAt": { "type": "string", "format": "date-time" },
          "files": {
            "type": "object",
            "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        }
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
    }
  },
  "additionalProperties": true
}
