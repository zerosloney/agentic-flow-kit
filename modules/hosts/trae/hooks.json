{
  "version": 1,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "RunCommand|Bash|Shell|Terminal",
        "hooks": [
          {
            "type": "command",
            "command": "node .trae/hooks/pre-shell-check.cjs",
            "timeout": 800
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .trae/hooks/post-edit-check.cjs",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
