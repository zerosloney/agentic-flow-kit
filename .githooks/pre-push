#!/bin/sh
# Git 原生 pre-push hook（经 core.hooksPath 挂载，git push 时触发）
# 跑 .agents/scripts/check-loop.sh：扫 workflow/ 闭环骨架断档
#   - 硬阻断（exit 1）= 配对断裂 / 回路断档 → push 立即阻断
#   - 警告（advisory）= 状态未确认 / 模板占位残留 / 引用漂移 等卫生项 → 仅打印提示
# stdin 有行时，每个非删除的本地 sha 用 --rev 扫那棵树。没有行时（手跑钩子）仍无参数扫工作区。
#
# experiment/* 泳道（2026-09-30 hybrid-governance-explore-hardening）：**目标分支**为 experiment/* 时，
#   闭环扫描降级 advisory（报告不阻断）——快速 PoC 推送不因闭环断档被拦；转正（目标为 main）由加固门兜底。
# 加固门（同日；2026-10-01 v09-review-defects 修正判定键）：推送**目标**为 refs/heads/main 时以
#   --hardening 运行（无论来源分支——experiment/* 直推 main 同样覆盖），exploring 任务须先收口
#   （intent approved/done + 同名 plan 在场 + L2/L3 另须同名 spec；判据见 check-loop.mjs 加固门段），
#   hard 失败即阻断 push，防「未文档化的探索件」进 main。
#
# 机器门：本地钩子（唯一机器门）——kit 不附带 CI 配置，装户仓裸装无跨环境保证。
# kit 源仓：.github/workflows/ci.yml 于 push main / 全部 PR 复跑 check-loop / doctor / source-sync-check --gate / workflows-check 四道门。
# 装户仓（无 templates/ 包源）：无 CI——source-sync-check --gate / doctor / flow-kit 命令不适用（引用即失败），本地钩子即全部机器门。
# 不要用 `git push --no-verify` 绕开——发现 hard-block 应先修 workflow 文档再推。

cd "$(git rev-parse --show-toplevel)" || exit 1

SCRIPT=".agents/scripts/check-loop.sh"
if [ ! -f "$SCRIPT" ]; then
  echo "pre-push: 未找到 $SCRIPT，跳过闭环扫描" >&2
  exit 0
fi

run_loop() {
  if command -v sh >/dev/null 2>&1; then
    sh "$SCRIPT" "$@"
  else
    bash "$SCRIPT" "$@"
  fi
}

saw=0
rc=0
while read -r local_ref local_sha remote_ref _remote_sha; do
saw=1
case "$local_sha" in
*[!0]*) ;;
*) continue ;;
esac
# 按目标分支三态分派（2026-10-01 v09-review-defects：判定键从 local_ref 改为 remote_ref——
# 修复 experiment/*→main 直推被 advisory continue 吞掉加固门的漏口）：
#   main            → 加固门（必带 --hardening）
#   experiment/*    → advisory（报告不阻断）
#   其他            → 全量扫描
case "$remote_ref" in
refs/heads/main|main)
run_loop --rev "$local_sha" --hardening
;;
refs/heads/experiment/*|experiment/*)
echo "pre-push: experiment/* 目标分支（$remote_ref）——闭环扫描降级 advisory，不阻断" >&2
if command -v sh >/dev/null 2>&1; then
sh "$SCRIPT" --rev "$local_sha" >&2 || echo "pre-push: （advisory）闭环断档已在上方列出——experiment 泳道可推送，转正（推 main）须过加固门" >&2
else
bash "$SCRIPT" --rev "$local_sha" >&2 || echo "pre-push: （advisory）闭环断档已在上方列出——experiment 泳道可推送，转正（推 main）须过加固门" >&2
fi
;;
*)
run_loop --rev "$local_sha"
;;
esac
one=$?
if [ "$one" -ne 0 ] && [ "$rc" -eq 0 ]; then
rc=$one
fi
done

if [ "$saw" -eq 0 ]; then
  run_loop
  rc=$?
fi

if [ "$rc" -ne 0 ]; then
  echo "pre-push: 闭环骨架断档（hard-block）未通过，push 已阻断。修 workflow 文档后重推——不要用 --no-verify 绕过（本钩子是唯一机器门，无服务端兜底，见头部说明）" >&2
  echo "pre-push: 若为「加固未过」= experiment 泳道件转正前须收口：intent approved/done + 同名 plan（L2/L3 另须 spec）且状态非 draft" >&2
  exit "$rc"
fi
exit 0
