#!/usr/bin/env node
// Git 原生 pre-push hook（经 core.hooksPath 挂载，git push 时触发）— agentic-flow-kit 通用编排
// 2026-10-16 node 化（pre-push 面）：钩子体不再含 sh 逻辑——git 仍以自带
// sh 启动本文件（钩子机制要求），但 shebang 即 node，PATH 无 sh 不影响任何逻辑。写法为 CommonJS——
// 无扩展名文件 node 缺省按 CJS 解析，不依赖 ≥22.7 的 ESM 语法探测。
// 跑 .agents/scripts/check-loop.mjs：扫 workflow/ 闭环骨架断档（默认只扫硬门）
//   - 硬阻断（exit 1）= 配对断裂 / 回路断档 / 证据与确认链 / 发版未收口 → push 立即阻断
//   - 卫生段（模板占位 / 引用漂移 / 宿主副本 / 索引）不在本钩子。要看时跑 --hygiene 或 --all
// stdin 有行时，每个非删除的本地 sha 用 --rev 扫那棵树。没有行时（手跑钩子）仍无参数扫工作区。
//
// 构建门（2026-10-16 自 pre-commit 后移）：另跑 commit-check.cjs --range <old> <new> 按推送范围条件构建
// （常规提交时刻只做敏感扫描——提交内环提速；构建执法集中到推送与关单）。范围匹配逻辑单源 =
// commit-check.cjs。experiment/* 目标降级 advisory。手动运行（无 stdin 推送行）无范围事实，构建门跳过。
//
// experiment/* 泳道：**目标分支**为 experiment/* 时，闭环扫描与构建门降级 advisory（报告不阻断）——
// 快速 PoC 推送不因闭环断档/构建失败被拦；转正（目标为 main）由加固门兜底。
// 加固门（2026-10-01 v09-review-defects）：推送**目标**为 refs/heads/main 时以 --hardening 运行
// （无论来源分支——experiment/* 直推 main 同样覆盖），exploring 任务须先收口（intent approved/done +
// 同名 plan 在场 + L2/L3 另须同名 spec；判据见 check-loop.mjs 加固门段），hard 失败即阻断 push。
//
// 回路日检（2026-10-16）：退役催办与 papercut 报债此前无调度，机制空转。每个
// 本地日在推送成功路径跑一次，advisory，失败不改退出码。摘要落 .agents/cache/loop-watch.jsonl（gitignore）。
//
// 机器门：本地钩子跑 check-loop.mjs。装户仓的远端门是随包下发的 .github/workflows/kit-ci.yml（verify.mjs）。
// kit 源仓：.github/workflows/ci.yml 于 push main / 全部 PR 跑 npm test（lint + 全量套件）。
// 不要用 `git push --no-verify` 绕开——发现 hard-block 应先修 workflow 文档再推。
const { spawnSync } = require('node:child_process');
const fs = require('node:fs');

const top = spawnSync('git', ['rev-parse', '--show-toplevel'], { encoding: 'utf8' });
if (top.status !== 0 || !top.stdout.trim()) {
  console.error('pre-push: 无法定位仓库根——推送已阻止');
  process.exit(1);
}
process.chdir(top.stdout.trim());

const LOOP = '.agents/scripts/check-loop.mjs';
if (!fs.existsSync(LOOP)) {
  console.error(`pre-push: 未找到 ${LOOP}——闭环扫描无法执行，推送已阻止（脚本随包下发；flow-kit sync 恢复后重试）`);
  process.exit(1);
}
// 构建门脚本（2026-10-16 自 pre-commit 后移）：缺失 fail-closed
const BUILD_CHECK = '.agents/hooks/commit-check.cjs';
if (!fs.existsSync(BUILD_CHECK)) {
  console.error(`pre-push: 未找到 ${BUILD_CHECK}——构建门无法执行，推送已阻止（脚本随包下发；git checkout -- ${BUILD_CHECK} 恢复后重试）`);
  process.exit(1);
}

const runLoop = (args = []) => spawnSync(process.execPath, [LOOP, ...args], { stdio: 'inherit' });
// 范围参数：远端全零 sha（新分支首推）→ 全量构建语义（commit-check 认全零 old）
const rangeArgsOf = (remoteSha, localSha) => ['--range', remoteSha && !/^0+$/.test(remoteSha) ? remoteSha : '0'.repeat(40), localSha];

let stdinText = '';
try { stdinText = fs.readFileSync(0, 'utf8'); } catch { stdinText = ''; }

let saw = 0;
let rc = 0;
for (const line of stdinText.split(/\r?\n/)) {
  if (!line.trim()) continue;
  const parts = line.trim().split(/\s+/);
  if (parts.length < 4) continue;
  const [localRef, localSha, remoteRef, remoteSha] = parts;
  saw = 1;
  if (/^0+$/.test(localSha)) continue; // 删除推送不扫
  // 按目标分支分派（判定键 = remote_ref）：
  // main → 加固门（必带 --hardening）；experiment/* → advisory（报告不阻断）；其他 → 全量扫描（硬门）
  if (/^refs\/heads\/main$|^main$/.test(remoteRef)) {
    const r = runLoop(['--rev', localSha, '--hardening']);
    if (r.status !== 0 && rc === 0) rc = r.status === null ? 1 : r.status;
    const rb = spawnSync(process.execPath, [BUILD_CHECK, ...rangeArgsOf(remoteSha, localSha)], { stdio: 'inherit' });
    if (rb.status !== 0 && rc === 0) rc = rb.status === null ? 1 : rb.status;
  } else if (/^refs\/heads\/experiment\/|^experiment\//.test(remoteRef)) {
    console.error(`pre-push: experiment/* 目标分支（${remoteRef}）——闭环扫描与构建门降级 advisory，不阻断`);
    const adv = spawnSync(process.execPath, [LOOP, '--rev', localSha], { stdio: 'inherit' });
    if (adv.status !== 0) console.error('pre-push: （advisory）闭环断档已在上方列出——experiment 泳道可推送，转正（推 main）须过加固门');
    const advB = spawnSync(process.execPath, [BUILD_CHECK, ...rangeArgsOf(remoteSha, localSha)], { stdio: 'inherit' });
    if (advB.status !== 0) console.error('pre-push: （advisory）构建门未过已在上方列出——experiment 泳道不阻断推送');
  } else {
    const r = runLoop(['--rev', localSha]);
    if (r.status !== 0 && rc === 0) rc = r.status === null ? 1 : r.status;
    const rb = spawnSync(process.execPath, [BUILD_CHECK, ...rangeArgsOf(remoteSha, localSha)], { stdio: 'inherit' });
    if (rb.status !== 0 && rc === 0) rc = rb.status === null ? 1 : rb.status;
  }
}

if (saw === 0) {
  const r = runLoop();
  if (r.status !== 0) rc = r.status === null ? 1 : r.status;
  console.error('pre-push: 手动运行无推送范围——构建门跳过（真实推送时按 old..new 范围执法）');
}

if (rc !== 0) {
  console.error('pre-push: 闭环骨架断档 / 构建未过（hard-block）未通过，push 已阻断。修 workflow 文档 / 构建错误后重推——不要用 --no-verify 绕过（本钩子是唯一机器门，无服务端兜底，见头部说明）');
  console.error('pre-push: 若为「加固未过」= experiment 泳道件转正前须收口：intent approved/done + 同名 plan（L2/L3 另须 spec）且状态非 draft');
  process.exit(rc);
}

// 回路日检（2026-10-16）：每个本地日在推送成功路径跑一次，advisory，失败不改退出码。
try {
  const cacheDir = '.agents/cache';
  const stampPath = `${cacheDir}/loop-watch-stamp`;
  const ledgerPath = `${cacheDir}/loop-watch.jsonl`;
  const now = new Date();
  const today = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;
  let prev = '';
  try { prev = fs.readFileSync(stampPath, 'utf8').trim(); } catch { /* 首跑 */ }
  if (prev !== today) {
    fs.mkdirSync(cacheDir, { recursive: true });
    // 退役催办：mechanism-retire-watch（--json 产 actions）；papercut 报债：kit 复用 sensor --json 取 debt
    const jobs = [
      ['retire-watch', '.agents/scripts/mechanism-retire-watch.mjs'],
      ['papercut-report', '.agents/scripts/papercut-debt-sensor.mjs'],
    ];
    const runs = [];
    for (const [id, script] of jobs) {
      if (!fs.existsSync(script)) { runs.push({ id, missing: true }); continue; }
      const r = spawnSync(process.execPath, [script, '--json'], { encoding: 'utf8', maxBuffer: 8 * 1024 * 1024 });
      let summary = {};
      try { summary = JSON.parse(r.stdout || '{}'); } catch { summary = { parseError: true }; }
      runs.push({
        id,
        exit: r.status,
        actions: Array.isArray(summary.actions) ? summary.actions.length : null,
        debt: typeof summary.debt === 'number' ? summary.debt : null,
      });
    }
    fs.appendFileSync(ledgerPath, `${JSON.stringify({ ts: now.toISOString(), day: today, runs })}\n`);
    fs.writeFileSync(stampPath, `${today}\n`);
    const retire = runs.find((x) => x.id === 'retire-watch');
    const paper = runs.find((x) => x.id === 'papercut-report');
    console.error(`pre-push: （advisory）回路日检已记 ${ledgerPath}（退役动作 ${retire && retire.actions != null ? retire.actions : '?'}，papercut debt ${paper && paper.debt != null ? paper.debt : '?'}）`);
  }
} catch (e) {
  console.error(`pre-push: （advisory）回路日检跳过——${e.message}`);
}
process.exit(0);
